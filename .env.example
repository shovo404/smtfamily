# ─── Required: Supabase Connection ─────────────────────────────────────────
# For local dev: copy this file to .env and fill in the values.
# For production: set these as Netlify environment variables.

# VITE_ prefixed vars → available to client + SSR code via import.meta.env
# Non-prefixed vars  → available to server code via process.env
# The code checks VITE_* first, then non-prefixed, and tries BOTH
# SUPABASE_ANON_KEY and SUPABASE_PUBLISHABLE_KEY naming conventions.

# ── Supabase Project URL ──
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_URL="https://your-project-id.supabase.co"

# ── Supabase Anon Key (safe for client-side) ──
# Use either ANON_KEY or PUBLISHABLE_KEY naming (both are checked).
# Old-style: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# New-style: sb_publishable_xxxxx
VITE_SUPABASE_ANON_KEY="your-anon-key"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# ─── Required for Server Admin Operations ⚠️ SECRET ──────────────────────
# Service role key — server-only, NEVER expose to client.
# Get it from: Supabase Dashboard → Project Settings → API → service_role key
# VITE_SUPABASE_SERVICE_ROLE_KEY can be used in dev (Vite loads .env into import.meta.env)
VITE_SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
